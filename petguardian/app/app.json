{
  "expo": {
    "name": "PetGuardian",
    "slug": "petguardian",
    "scheme": "petguardian",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petguardian.app"
    },
    "android": {
      "package": "com.petguardian.app"
    },
    "extra": {
      "note": "Public config only. Secrets come from EXPO_PUBLIC_* env vars, never here."
    }
  }
}
