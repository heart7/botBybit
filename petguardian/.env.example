# PetGuardian — environment template. Copy to .env and fill in.
# Commit ONLY this example file, never a real .env.

# ---------------------------------------------------------------------------
# Client (Expo) — SAFE to ship in the app bundle.
# Expo inlines variables prefixed with EXPO_PUBLIC_. Put ONLY public values here:
# the project URL and the anon key. NEVER the service-role key (guardrail: Doc 09 §5).
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# ---------------------------------------------------------------------------
# Server only — used by Supabase Edge Functions / CI. NEVER exposed to the client.
# These are read by trusted backend code (Steps 6+), not by the Expo app.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="server-side-only-never-in-client"
OPENAI_API_KEY="server-side-only-never-in-client"
